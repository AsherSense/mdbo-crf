        },
        {
          "id": "notes",
          "label": "补充说明 / 其他选项说明",
          "type": "textarea",
          "hint": ""
        }
      ]
    },
    {
      "id": "month1",
      "title": "术后1个月 · 随访与30天并发症",
      "month": 1,
      "window": 7,
      "source": "CRF-06；CRF-05的30天事件移至此处",
