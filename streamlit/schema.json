{
  "modules": [
    {
      "id": "screen",
      "title": "入院 · 筛选与知情同意",
      "source": "CRF-01；方案第8–9页",
      "fields": [
        {
          "id": "admissionDate",
          "label": "入院日期",
          "type": "date",
          "hint": ""
        },
        {
          "id": "date",
          "label": "筛选日期",
          "type": "date",
          "required": true,
          "hint": "按实际筛选日填写。"
        },
        {
          "id": "initials",
          "label": "姓名拼音首字母（可留空）",
          "type": "text",
          "hint": "按CRF，可留空；不要求录入患者全名。"
        },
        {
          "id": "age",
          "label": "年龄（岁）",
          "type": "number",
          "min": 0,
          "integer": true,
          "max": 120,
          "required": true,
          "hint": "方案入组年龄≥18岁。"
        },
        {
          "id": "sex",
          "label": "性别",
          "type": "select",
          "options": [
            "男",
            "女"
          ],
          "hint": ""
        },
        {
          "id": "consent",
          "label": "已签署知情同意",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "required": true,
          "hint": "签署书面知情同意后方可开始研究相关流程。"
        },
        {
          "id": "consentDate",
          "label": "知情同意日期",
          "type": "date",
          "hint": "不得晚于中央随机化ERCP日期。"
        },
        {
          "id": "eligibility",
          "label": "纳入 / 排除标准核对",
          "type": "select",
          "options": [
            "符合全部纳入标准，且无任何排除标准",
            "不符合",
            "待核实"
          ],
          "required": true,
          "hint": "综合核对后选择一次即可；下方可展开查看完整标准。"
        },
        {
          "id": "notes",
          "label": "补充说明 / 其他选项说明",
          "type": "textarea",
          "hint": ""
        }
      ]
    },
    {
      "id": "baseline",
      "title": "术前 · 基线资料",
      "source": "CRF-02",
      "fields": [
        {
          "id": "date",
          "label": "实验室检查日期（术前7天内）",
          "type": "date",
          "hint": "TBIL基线采用术前7天内结果；按检验单记录日期。"
        },
        {
          "id": "ecog",
          "label": "ECOG评分",
          "type": "select",
          "options": [
            "0",
            "1",
            "2"
          ],
          "required": true,
          "hint": "入组允许0、1或2分；详细评分标准见下方评分备注。"
        },
        {
          "id": "tumor",
          "label": "原发肿瘤类型",
          "type": "select",
          "options": [
            "胰腺癌",
            "远端胆管癌",
            "壶腹癌",
            "胆囊癌",
            "转移性淋巴结压迫",
            "其他符合方案的恶性肿瘤"
          ],
          "required": true,
          "hint": "按确诊原发肿瘤填写；自动归入胰腺癌P / 非胰腺癌NP层。"
        },
        {
          "id": "tnm",
          "label": "TNM分期（如适用）",
          "type": "text",
          "hint": "按原发癌种及报告记录TNM、总分期、版本与依据；展开下方备注核对，不能混用不同癌种标准。"
        },
        {
          "id": "distance",
          "label": "梗阻距肝门汇合处（cm）",
          "type": "number",
          "min": 0,
          "hint": "按影像记录狭窄距肝门汇合处距离；入组要求≥2cm。"
        },
        {
          "id": "drain",
          "label": "既往胆道引流史",
          "type": "select",
          "options": [
            "无",
            "塑料支架",
            "鼻胆管",
            "其他"
          ],
          "hint": "既往金属支架置入属于排除标准；本项如实记录既往引流。"
        },
        {
          "id": "tbil",
          "label": "TBIL（μmol/L）",
          "type": "number",
          "min": 0,
          "hint": "按检验单原值及上方单位填写；未检测请留空。"
        },
        {
          "id": "alp",
          "label": "ALP（U/L）",
          "type": "number",
          "min": 0,
          "hint": "按检验单原值及上方单位填写；未检测请留空。"
        },
        {
          "id": "alt",
          "label": "ALT（U/L）",
          "type": "number",
          "min": 0,
          "hint": "按检验单原值及上方单位填写；未检测请留空。"
        },
        {
          "id": "ast",
          "label": "AST（U/L）",
          "type": "number",
          "min": 0,
          "hint": "按检验单原值及上方单位填写；未检测请留空。"
        },
        {
          "id": "wbc",
          "label": "WBC（×10⁹/L）",
          "type": "number",
          "min": 0,
          "hint": "按检验单原值及上方单位填写；未检测请留空。"
        },
        {
          "id": "platelets",
          "label": "血小板（×10⁹/L）",
          "type": "number",
          "min": 0,
          "hint": "单位×10⁹/L；方案排除：纠正后仍<50。"
        },
        {
          "id": "inr",
          "label": "INR",
          "type": "number",
          "min": 0,
          "hint": "方案排除：纠正后仍INR>1.5；勿用纠正前结果代替纠正后判断。"
        },
        {
          "id": "creatinine",
          "label": "肌酐（μmol/L）",
          "type": "number",
          "min": 0,
          "hint": "按检验单原值及上方单位填写；未检测请留空。"
        },
        {
          "id": "ca199",
          "label": "CA19-9（U/mL）",
          "type": "number",
          "min": 0,
          "hint": "按检验单原值及上方单位填写；未检测请留空。"
        },
        {
          "id": "notes",
          "label": "补充说明 / 其他选项说明",
          "type": "textarea",
          "hint": ""
        }
      ]
    },
    {
      "id": "random",
      "title": "术中 · 中央随机化",
      "source": "方案第9页；Excel中央随机化登记",
      "fields": [
        {
          "id": "eligibility",
          "label": "已核实符合全部纳入条件、无排除条件，并已签署知情同意",
          "type": "select",
          "options": [
            "符合全部纳入标准，且无任何排除标准",
            "不符合",
            "待核实"
          ],
          "required": true,
          "hint": ""
        },
        {
          "id": "stratum",
          "label": "随机分层：肿瘤类型",
          "type": "select",
          "options": [
            "P",
            "NP"
          ],
          "required": true,
          "hint": "P＝胰腺癌，NP＝非胰腺癌。用于获批动态随机算法，不能缺省或由系统猜测；详细病理资料可稍后补录。"
        },
        {
          "id": "date",
          "label": "ERCP日期",
          "type": "date",
          "required": true,
          "hint": "实际ERCP日期；必须在导丝成功跨越狭窄后申请随机。"
        },
        {
          "id": "guidewire",
          "label": "导丝已成功跨越狭窄",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "required": true,
          "hint": "选择“是”且资格核对通过后才能分配。"
        },
        {
          "id": "operator",
          "label": "随机执行人姓名",
          "type": "text",
          "required": true,
          "hint": "实际执行中央随机化的人员姓名；分配后固定保留。"
        },
        {
          "id": "notes",
          "label": "补充说明 / 其他选项说明",
          "type": "textarea",
          "hint": ""
        }
      ]
    },
    {
      "id": "procedure",
      "title": "手术 · ERCP / 支架 / 夹锚定",
      "source": "CRF-03/04；方案第9页",
      "fields": [
        {
          "id": "conforms",
          "label": "是否按随机组方案完成",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "hint": "随机后计划治疗自动带入并变灰；术后核对真实操作。"
        },
        {
          "id": "date",
          "label": "支架置入日期",
          "type": "date",
          "required": true,
          "hint": "实际支架置入日，是随访、180天终点和TRBO的起算日期。"
        },
        {
          "id": "anesthesia",
          "label": "镇静/麻醉方式",
          "type": "select",
          "options": [
            "镇静",
            "全麻",
            "其他"
          ],
          "hint": "选择其他时，在本模块补充说明中填写具体情况。"
        },
        {
          "id": "est",
          "label": "乳头处理（EST / ESBD）",
          "type": "select",
          "options": [
            "EST（内镜乳头括约肌切开术）",
            "ESBD（内镜乳头括约肌球囊扩张术）",
            "EST + ESBD",
            "均未做",
            "其他"
          ],
          "hint": "选择其他时，在本模块补充说明中填写具体情况。"
        },
        {
          "id": "estDetail",
          "label": "EST / ESBD具体操作与其他说明",
          "type": "text",
          "hint": ""
        },
        {
          "id": "nasal",
          "label": "是否置入鼻胆管",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "hint": ""
        },
        {
          "id": "stenosis",
          "label": "狭窄段长度（cm）",
          "type": "number",
          "min": 0,
          "hint": "按术中造影测量，单位cm。"
        },
        {
          "id": "actual",
          "label": "实际置入治疗",
          "type": "select",
          "options": [
            "夹锚定FCSEMS",
            "UCSEMS",
            "其他",
            "未置入"
          ],
          "hint": "如实记录实际治疗；不会改变已锁定的随机组。"
        },
        {
          "id": "stentModel",
          "label": "支架厂家 / 型号",
          "type": "text",
          "hint": "按备案名称填写厂家和型号。"
        },
        {
          "id": "diameter",
          "label": "实际支架直径（mm）",
          "type": "number",
          "min": 0,
          "hint": "方案要求10mm；如有偏离请如实记录。"
        },
        {
          "id": "length",
          "label": "支架长度（mm）",
          "type": "number",
          "min": 0,
          "hint": "按实际置入支架记录，单位mm。"
        },
        {
          "id": "release",
          "label": "支架释放方式",
          "type": "select",
          "options": [
            "跨乳头放置",
            "其他"
          ],
          "hint": "方案两组均跨乳头放置；偏离时选择其他并说明。"
        },
        {
          "id": "technical",
          "label": "技术成功（覆盖狭窄全长且透视位置理想）",
          "type": "select",
          "options": [
            "是",
            "否"
          ],
          "hint": "成功释放并覆盖狭窄全长，且透视下位置理想。"
        },
        {
          "id": "complication",
          "label": "术中并发症",
          "type": "select",
          "options": [
            "无",
            "出血",
            "穿孔",
            "其他"
          ],
          "hint": "选择其他时，在本模块补充说明中填写具体情况。"
        },
        {
          "id": "clip",
          "label": "是否实施夹锚定",
          "type": "select",
          "options": [
            "是",
            "否",
            "NA"
          ],
          "hint": "试验组夹锚定；对照组不锚定，填NA。"
        },
        {
          "id": "clipType",
          "label": "夹子类型（方案）",
          "type": "text",
          "hint": ""
        },
        {
          "id": "clipModel",
          "label": "夹子品牌 / 型号",
          "type": "text",
          "hint": "按备案名称填写；对照组可留空。"
        },
        {
          "id": "clipCount",
          "label": "实际夹数量（枚）",
          "type": "number",
          "min": 0,
          "integer": true,
          "hint": "试验组方案为2枚；对照组不锚定。"
        },
        {
          "id": "exposure",
          "label": "远端外露长度（mm）",
          "type": "number",
          "min": 0,
          "hint": "方案约5–10mm"
        },
        {
          "id": "deviation",
          "label": "方案偏离原因 / 夹锚定备注",
          "type": "textarea",
          "hint": "实际治疗、直径、释放方式或夹数量偏离方案时写明原因。"
        },
        {
          "id": "notes",
          "label": "补充说明 / 其他选项说明",
          "type": "textarea",
          "hint": ""
        }
      ]
    },
    {
      "id": "ae",
      "title": "不良事件及严重不良事件",
      "repeat": true,
      "source": "CRF-08；方案第11页",
      "fields": [
        {
          "id": "date",
          "label": "发生日期",
          "type": "date",
          "required": true,
          "hint": ""
        },
        {
          "id": "event",
          "label": "事件名称",
          "type": "text",
          "required": true,
          "hint": "CRF示例：胰腺炎、胆囊炎、出血、穿孔、感染、夹相关损伤。"
        },
        {
          "id": "severity",
          "label": "严重程度",
          "type": "select",
          "options": [
            "轻",
            "中",
            "重",
            "致死"
          ],
          "hint": "事件严重程度与是否SAE分别判断；致死应核对SAE死亡项。"
        },
        {
          "id": "sae",
          "label": "是否SAE",
          "type": "select",
          "options": [
            "否",
            "是-死亡",
            "是-危及生命",
            "是-住院/延长住院",
            "是-致残",
            "是-其他"
          ],
          "hint": "包括死亡、危及生命、住院/延长住院、致残及其他重要医学事件。"
        },
        {
          "id": "related",
          "label": "与器械/操作相关性",
          "type": "select",
          "options": [
            "无关",
            "可能相关",
            "很可能相关",
            "肯定相关"
          ],
          "hint": ""
        },
        {
          "id": "measure",
          "label": "处理措施",
          "type": "select",
          "options": [
            "对症",
            "抗生素",
            "输血",
            "内镜处理",
            "外科/介入",
            "其他"
          ],
          "hint": "选择其他时，在本模块补充说明中填写具体情况。"
        },
        {
          "id": "outcome",
          "label": "转归",
          "type": "select",
          "options": [
            "痊愈",
            "好转",
            "未愈",
            "后遗症",
            "死亡"
          ],
          "hint": ""
        },
        {
          "id": "awareAt",
          "label": "获知时间",
          "type": "datetime-local",
          "hint": "首次获知事件的实际时间，用于核对24小时上报时限。"
        },
        {
          "id": "reported",
          "label": "上报情况",
          "type": "select",
          "options": [
            "不适用",
            "24h内上报PI/DSMB/伦理",
            "其他"
          ],
          "hint": "SAE在获知后24小时内上报PI、DSMB和伦理委员会。"
        },
        {
          "id": "reportedAt",
          "label": "上报时间",
          "type": "datetime-local",
          "hint": "实际上报时间；超过24小时也应如实填写。"
        },
        {
          "id": "notes",
          "label": "补充说明 / 其他选项说明",
          "type": "textarea",
          "hint": ""
        }
      ]
    },
    {
      "id": "week2",
      "title": "术后2周 · 14天随访",
