            "住院"
          ],
          "hint": ""
        },
        {
          "id": "symptom",
          "label": "临床症状",
          "type": "select",
          "options": [
            "无",
            "黄疸",
            "发热/寒战",
            "腹痛",
            "其他"
          ],
          "hint": "选择其他时，在本模块补充说明中填写具体情况。"
